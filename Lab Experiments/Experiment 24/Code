import numpy as np
from sklearn.neighbors import KNeighborsClassifier
from sklearn.preprocessing import StandardScaler
from sklearn.pipeline import make_pipeline

X = np.array([
    [1, 2],
    [2, 3],
    [3, 2],
    [2, 1],
    [7, 8],
    [8, 9],
    [9, 8],
    [8, 7],
    [3, 4],
    [7, 7]
])

y = np.array([0, 0, 0, 0, 1, 1, 1, 1, 0, 1])

k = int(input("Enter number of neighbors (k): "))

if k < 1 or k > len(X):
    print("Invalid k value")
else:
    model = make_pipeline(
        StandardScaler(),
        KNeighborsClassifier(n_neighbors=k)
    )

    model.fit(X, y)

    age_symptom = float(input("Enter symptom 1 value: "))
    fever = float(input("Enter symptom 2 value: "))

    patient = [[age_symptom, fever]]

    prediction = model.predict(patient)

    if prediction[0] == 1:
        print("Patient has the medical condition.")
    else:
        print("Patient does not have the medical condition.")
