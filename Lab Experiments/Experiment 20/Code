import numpy as np
from scipy import stats

A = np.array([
    2.5, 3.0, 2.8, 3.2, 2.9,
    3.1, 2.7, 3.3, 2.6, 3.0
])

B = np.array([
    3.5, 3.8, 3.6, 4.0, 3.9,
    3.7, 4.1, 3.8, 3.6, 4.0
])

mean_A = np.mean(A)
mean_B = np.mean(B)

t_stat, p_value = stats.ttest_ind(A, B)

print("Mean Conversion Rate A:", mean_A)
print("Mean Conversion Rate B:", mean_B)

print("T-statistic:", t_stat)
print("P-value:", p_value)

if p_value < 0.05:
    print("There is a significant difference.")
else:
    print("There is no significant difference.")
