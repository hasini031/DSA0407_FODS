import pandas as pd
from sklearn.linear_model import LogisticRegression

df = pd.DataFrame({
    "minutes": [100,200,300,400,500,600],
    "contract": [12,24,6,3,2,1],
    "churn": [0,0,0,1,1,1]
})

X = df[["minutes","contract"]]
y = df["churn"]

model = LogisticRegression()
model.fit(X,y)

m = float(input("Usage minutes: "))
c = int(input("Contract duration: "))

p = model.predict([[m,c]])
print("Churn:", "Yes" if p[0]==1 else "No")
