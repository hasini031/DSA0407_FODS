import pandas as pd
from sklearn.cluster import KMeans

df = pd.DataFrame({
    "Customer": [1,2,3,4,5,6],
    "Amount": [100,150,200,700,800,900],
    "Visits": [2,3,4,8,9,10]
})

X = df[["Amount","Visits"]]

model = KMeans(n_clusters=3, random_state=42, n_init=10)
df["Cluster"] = model.fit_predict(X)

print(df)
