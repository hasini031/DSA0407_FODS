import numpy as np
import matplotlib.pyplot as plt
from scipy import stats

control = np.array([
    5, 6, 4, 7, 5, 6, 5, 4, 6, 5
])

treatment = np.array([
    12, 14, 13, 15, 11, 16, 14, 13, 15, 12
])

mean_control = np.mean(control)
mean_treatment = np.mean(treatment)

t_stat, p_value = stats.ttest_ind(
    control, treatment
)

print("Control Group Mean:", mean_control)
print("Treatment Group Mean:", mean_treatment)

print("T-statistic:", t_stat)
print("P-value:", p_value)

if p_value < 0.05:
    print("Reject Null Hypothesis")
    print("Treatment has a significant effect.")
else:
    print("Accept Null Hypothesis")
    print("No significant effect found.")

plt.bar(
    ["Control", "Treatment"],
    [mean_control, mean_treatment]
)

plt.ylabel("Mean Value")
plt.title("Treatment Effect Comparison")

plt.text(
    0.5,
    max(mean_control, mean_treatment),
    "P-value = " + str(round(p_value, 5)),
    ha="center"
)

plt.show()
